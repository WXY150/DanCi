PORT=4173
PUBLIC_ORIGIN=https://api.example.com
CORS_ORIGINS=https://servicewechat.com
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=danci
DB_REQUIRED=true
SESSION_SECRET=replace_with_at_least_32_random_characters

# WeChat mini program server-side login
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret

# Persistent generated image directory (optional; defaults to ./generated)
IMAGE_DIR=generated

# OpenAI API 配置（用于 AI 图片生成，可选）
OPENAI_API_KEY=your_openai_compatible_api_key
# 中转站按分组授权时分别填写；留空则使用上面的通用 Key
TEXT_API_KEY=
IMAGE_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
TEXT_MODEL=gpt-4
IMAGE_MODEL=dall-e-3
IMAGE_SIZE=1536x1152

# 说明：
# 1. MYSQL_PASSWORD 必须填写，这是 MySQL 数据库的 root 用户密码
# 2. OPENAI_API_KEY 仅在需要使用 AI 图片生成功能时填写
# 3. 首次启动会自动创建数据库和表结构
# 4. 默认管理员账户：admin / admin123（首次登录后请立即修改）
