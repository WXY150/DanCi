.page { min-height: 100vh; padding: 40rpx; box-sizing: border-box; }
.card { padding: 48rpx 36rpx; border-radius: 24rpx; background: #fffefa; }
.word { display: block; font-size: 64rpx; font-weight: 800; }
.ipa { display: block; margin-top: 16rpx; color: #476780; }
.answer { margin-top: 36rpx; }
.meaning, .mnemonic { display: block; margin-top: 20rpx; color: #5e6b74; line-height: 1.7; }
.image { display: block; width: 100%; height: 360rpx; margin-top: 20rpx; border-radius: 16rpx; background: #f1f1ec; }
.actions { display: flex; gap: 20rpx; margin-top: 32rpx; }
.actions button { flex: 1; }
.error { display: block; margin-top: 24rpx; color: #b94e2d; }
