<view class="page">
  <view wx:if="{{word}}" class="card">
    <text class="word">{{word.word}}</text>
    <text class="ipa">{{word.phonetic}}</text>
    <button wx:if="{{!revealed}}" bindtap="onReveal">查看释义与联想图</button>
    <view wx:if="{{revealed}}" class="answer">
      <text class="meaning">{{word.meaning}}</text>
      <image wx:if="{{word.imageUrl && !imageUnavailable}}" binderror="onImageError" class="image" mode="aspectFit" src="{{word.imageUrl}}" />
      <text wx:if="{{imageUnavailable}}" class="image-fallback">联想图暂时不可用，文字内容仍可继续学习。</text>
      <text class="mnemonic">{{word.mnemonic}}</text>
    </view>
    <view class="actions">
      <button bindtap="onUnknown">{{revealed ? '还不会' : '想不起来'}}</button>
      <button bindtap="onKnown" type="primary">记住了</button>
    </view>
    <view wx:if="{{error}}" class="error"><text>{{error}}</text><button bindtap="onHome">返回首页刷新</button></view>
  </view>
  <view wx:else class="card">暂无词条</view>
</view>
